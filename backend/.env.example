PORT=5000
NODE_ENV=development

# MongoDB is optional. Without it, transactions are stored in this local JSON
# database and survive backend restarts.
# On serverless platforms (e.g. Vercel), if this location is not writable,
# the backend automatically falls back to temporary OS storage.
LOCAL_DB_PATH=./data/securepay.json

JWT_SECRET=your_secure_jwt_secret_key_here
HMAC_SECRET=your_secure_server_side_hmac_secret_key_here
NONCE_EXPIRY_SECONDS=300

# Set this to your GitHub Pages URL in production (Vercel environment variables)
# e.g. https://vinay-ops.github.io
CLIENT_URL=http://localhost:3000
